# ==============================================================================
# MonetiseUp RTB Bidding Server - Environment Configuration
# ==============================================================================

# --- Server & Auction Settings ---
PORT=3000
NODE_ENV=production
AUCTION_TIMEOUT_MS=150
# MonetiseUp Take-Rate Margin (0.20 = 20% deducted from winning gross CPM)
MONETISEUP_MARGIN_RATE=0.20

# --- Partner 1: Adagio ---
ENABLE_ADAGIO=true
ADAGIO_ENDPOINT_URL=https://mp.adagio.io/bid
ADAGIO_ORG_ID=your_adagio_org_id_here
ADAGIO_TIMEOUT_MS=120

# --- Partner 2: 152Media ---
ENABLE_152MEDIA=true
MEDIA152_ENDPOINT_URL=https://prebid.152media.com/endpoint
MEDIA152_SITE_ID=your_152media_site_id_here
MEDIA152_TIMEOUT_MS=120

# --- Partner 3: PubMatic ---
ENABLE_PUBMATIC=true
PUBMATIC_ENDPOINT_URL=https://hbopenbid.pubmatic.com/translator
PUBMATIC_PUBLISHER_ID=your_pubmatic_publisher_id_here
PUBMATIC_SITE_ID=your_pubmatic_site_id_here
PUBMATIC_TIMEOUT_MS=120

# --- Partner 4: OpenX ---
ENABLE_OPENX=true
OPENX_ENDPOINT_URL=https://rtb.openx.net/openrtbb/v2
OPENX_DEL_DOMAIN=your_openx_delivery_domain_here
OPENX_UNIT_ID=your_openx_unit_id_here
OPENX_TIMEOUT_MS=120

# --- Partner 5: Nobid ---
ENABLE_NOBID=true
NOBID_ENDPOINT_URL=https://ads.nobid.io/prebid
NOBID_SITE_ID=your_nobid_site_id_here
NOBID_TIMEOUT_MS=120

# --- Partner 6: OnlineMediaSolutions (OMS) ---
ENABLE_OMS=true
OMS_ENDPOINT_URL=https://prebid.onlinemediasolutions.com/bid
OMS_PUBLISHER_ID=your_oms_publisher_id_here
OMS_TIMEOUT_MS=120

# --- Partner 7: Scalibur ---
ENABLE_SCALIBUR=true
SCALIBUR_ENDPOINT_URL=https://rtb.scalibur.com/bid
SCALIBUR_API_KEY=your_scalibur_api_key_here
SCALIBUR_ZONE_ID=your_scalibur_zone_id_here
SCALIBUR_TIMEOUT_MS=120

# --- Partner 8: TripleLift (Enable when onboarding completes) ---
ENABLE_TRIPLELIFT=false
TRIPLELIFT_ENDPOINT_URL=https://tlx.3lift.com/header/auction
TRIPLELIFT_INV_CODE=your_triplelift_inv_code_here
TRIPLELIFT_TIMEOUT_MS=120

# --- Partner 9: Eskimi (Enable when onboarding completes) ---
ENABLE_ESKIMI=false
ESKIMI_ENDPOINT_URL=https://dsp.eskimi.com/openrtb
ESKIMI_TOKEN=your_eskimi_token_here
ESKIMI_TIMEOUT_MS=120

# --- Partner 10: Equativ (Enable when onboarding completes) ---
ENABLE_EQUATIV=false
EQUATIV_ENDPOINT_URL=https://prebid.smartadserver.com/api/bid
EQUATIV_NETWORK_ID=your_equativ_network_id_here
EQUATIV_SITE_ID=your_equativ_site_id_here
EQUATIV_TIMEOUT_MS=120
